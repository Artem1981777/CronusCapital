# Cronus Capital - environment variables
# Server (Vercel) - used by api/*.js serverless functions

# Groq API key for the live reasoning trace (/api/consult)
GROQ_API_KEY=your_groq_api_key_here

# x402 paywall / settlement
CRONUS_PAYTO=0xd4939e42bd3e0ec9cb00091778a331c35d1834aa
X402_NETWORK=arc-mainnet
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_CHAIN_ID=5042
SIGNAL_PRICE=20000
SIGNAL_MAX_AGE_SECONDS=1800

# Optional RPC override for on-chain verification / metrics
SIGNAL_RPC_URL=https://rpc.mainnet.arc.io
METRICS_BLOCK_WINDOW=2000000

# Only for the helper scripts that send REAL payments
# (scripts/pay-and-consult.mjs, scripts/pay-with-memo.mjs). Never commit a real key.
TREASURY_PRIVATE_KEY=your_funded_test_wallet_private_key_here

# Client (Vite) - optional; current build uses sensible defaults
# VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# CCTP EVM Mainnet: Arc <-> Base
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
ARC_MAINNET_CHAIN_ID=5042
ARC_MAINNET_CCTP_DOMAIN=26
ARC_MAINNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_MAINNET_TOKEN_MESSENGER_ADDRESS=0x28b5a0e9C621a5BadaA536219b3a228C8168cf5d
ARC_MAINNET_EXPLORER=https://explorer.arc.io/tx/

BASE_MAINNET_RPC=https://mainnet.base.org
BASE_MAINNET_CHAIN_ID=8453
BASE_MAINNET_CCTP_DOMAIN=6
BASE_MAINNET_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_MAINNET_TOKEN_MESSENGER_ADDRESS=0x28b5a0e9C621a5BadaA536219b3a228C8168cf5d
BASE_MAINNET_EXPLORER=https://basescan.org/tx/

CCTP_MAINNET_IRIS_URL=https://iris-api.circle.com
CCTP_MAINNET_MESSAGE_TRANSMITTER=0x81D40F21F12A8F0E3252Bccb954D722d4c464B64

# EVM bridge limits: 6-decimal USDC
BRIDGE_CAP_ATOMIC=5000000
BRIDGE_DAILY_CAP_ATOMIC=500000000
